################################################################################
# Build stage
################################################################################
FROM ubuntu:26.04 AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    autoconf \
    automake \
    libpcre2-dev \
    libevent-dev \
    pkg-config \
    zlib1g-dev \
    libssl-dev \
    git \
    cmake \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 https://github.com/RedisLabs/memtier_benchmark.git .
RUN autoreconf -ivf && ./configure && make -j"$(nproc)"

################################################################################
# Runtime stage
################################################################################
FROM ubuntu:26.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    libevent-2.1-7 \
    libevent-extra-2.1-7 \
    libevent-pthreads-2.1-7 \
    libevent-openssl-2.1-7 \
    libpcre2-8-0 \
    zlib1g \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/memtier_benchmark /usr/local/bin/memtier_benchmark

ENTRYPOINT ["memtier_benchmark"]
CMD ["--help"]
